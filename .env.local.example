# Copy this file to .env.local and fill in the values below.
#
# Setup order:
#   1. Run `pnpm dlx convex dev` once. Log in and create a new deployment.
#      This writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL into your .env.local
#      automatically.
#   2. Create a Clerk application at https://dashboard.clerk.com
#      - Copy the publishable key into VITE_CLERK_PUBLISHABLE_KEY
#      - Copy the secret key into CLERK_SECRET_KEY
#   3. In Clerk, create a new JWT Template named `convex` (required by
#      ConvexProviderWithClerk). Copy its Issuer URL.
#   4. In the Convex dashboard → Settings → Authentication, add a new provider
#      with the Clerk Issuer URL and applicationID. See
#      https://docs.convex.dev/auth/clerk for details.

# Convex (populated by `pnpm dlx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# WhatsApp Cloud API (Meta) — used for shopper-facing messaging only
# (cart handoff replies, status updates). Retailer alerts now go via email.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# HitPay — KEDAIPAL'S OWN account (subscription billing, 86eyb6z4r). Powers the
# invoice Pay-now links + tokenised auto-renewal. Convex deployment env vars —
# set via `npx convex env set`, never committed. Both or nothing: absent means
# every online-billing surface quietly hides and manual billing works as before.
# Sellers' BYO buyer-payment keys are unrelated (stored per-store, encrypted).
#   1. Keys from dashboard.hit-pay.com (sandbox: dashboard.sandbox.hit-pay.com)
#      → API Keys. Sandbox keys are `test_`-prefixed; mode is inferred.
#   2. The salt is shown beside the API key; it also signs the V2 event
#      webhooks — register <CONVEX_SITE_URL>/webhook/hitpay under Developers →
#      Webhook Endpoints (charge.created + the recurring_billing.* events).
HITPAY_BILLING_API_KEY=
HITPAY_BILLING_SALT=

# Email (Resend) — retailer-facing operational notifications
#   1. Sign up at https://resend.com and create an API key
#   2. Verify your sender domain (e.g. kedaipal.com) in the Resend dashboard
#      before deploying. Until verified, sends will fail with a 4xx and
#      retailers receive nothing — the action swallows the error and logs it.
#   3. EMAIL_FROM should match a verified sender on your domain.
RESEND_API_KEY=
EMAIL_FROM=Kedaipal Orders <orders@kedaipal.com>

# Google Analytics 4 — get Measurement ID from GA4 Admin → Data Streams → Web stream
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — session replays + heatmaps. Project ID from
# https://clarity.microsoft.com → Settings → Overview (Kedaipal project: xoduz9wjl5).
# Leave blank locally so dev/preview traffic stays out of the Clarity project.
VITE_CLARITY_PROJECT_ID=
