{
  "name": "kedaipal",
  "version": "2026.08.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "dev": "vite dev --port 3000",
    "dev:all": "concurrently -n \"convex,fe\" -c \"blue,green\" \"pnpm convex:dev\" \"pnpm dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "pnpm run build && wrangler deploy",
    "seed": "npx convex run seed:run",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
